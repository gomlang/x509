package tests;

use ecosystem::asn1;
use ecosystem::x509::pkix;
use std::testing;

fn raw_name(tag: u8, content: Vec[u8]) -> pkix::Name {
    pkix::Name {
        rdns: Vec::from_array(
            [
                Vec::from_array(
                    [
                        pkix::Attribute {
                            oid: pkix::common_name_oid(),
                            value: pkix::DirectoryValue::Raw(asn1::Tlv { tag, content }),
                        },
                    ],
                ),
            ],
        ),
    }
}

#[test]
fn raw_known_directory_strings_enforce_the_typed_validation() -> () {
    let limits = asn1::Limits::standard();
    for tag in Vec::from_array([12, 19, 20, 22, 28, 30]) {
        testing::assert_err(raw_name(tag, Vec::new()).to_der(limits));
    }
    for (tag, content) in Vec::from_array(
        [
            (12, Vec::from_array([255])),
            (19, Vec::from_array([64])),
            (22, Vec::from_array([128])),
            (30, Vec::from_array([0])),
            (30, Vec::from_array([216, 0])),
            (28, Vec::from_array([0, 0, 0])),
            (28, Vec::from_array([0, 0, 216, 0])),
            (28, Vec::from_array([0, 17, 0, 0])),
        ],
    ) {
        testing::assert_err(raw_name(tag, content).to_der(limits));
    }
}

#[test]
fn raw_valid_known_and_unknown_values_round_trip() -> () {
    let limits = asn1::Limits::standard();
    for (tag, content) in Vec::from_array(
        [
            (12, Vec::from_array([65])),
            (19, Vec::from_array([65])),
            (20, Vec::from_array([255])),
            (22, Vec::from_array([65])),
            (30, Vec::from_array([78, 45])),
            (28, Vec::from_array([0, 1, 246, 0])),
            (128, Vec::from_array([255, 0])),
            (160, Vec::from_array([5, 0])),
        ],
    ) {
        let encoded = testing::expect_ok(raw_name(tag, content).to_der(limits), "raw encoding");
        let decoded = testing::expect_ok(
            pkix::Name::from_der(encoded.as_slice(), limits),
            "raw decoding",
        );
        testing::assert(testing::expect_ok(decoded.to_der(limits), "raw roundtrip") == encoded);
    }
    testing::assert_err(raw_name(160, Vec::from_array([5, 1, 0])).to_der(limits));
}
