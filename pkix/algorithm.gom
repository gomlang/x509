package pkix;

use ecosystem::asn1;

impl AlgorithmIdentifier {
    pub fn from_der(input: Slice[u8], limits: asn1::Limits) -> Result[
        AlgorithmIdentifier,
        asn1::Error,
    ] {
        let fields = sequence(input, limits)?;
        if fields.len() != 1 && fields.len() != 2 {
            return Result::Err(invalid("AlgorithmIdentifier requires OID and optional parameters"))
        }
        let parameters_der = if fields.len() == 2 {
            Option::Some(asn1::encode_tlv(fields[1].tag, fields[1].content.as_slice(), limits)?)
        } else {
            Option::None
        };
        Result::Ok(AlgorithmIdentifier { oid: oid_value(fields[0], limits)?, parameters_der })
    }

    pub fn to_der(self: AlgorithmIdentifier, limits: asn1::Limits) -> Result[Vec[u8], asn1::Error] {
        let fields: Vec[Vec[u8]] = Vec::new();
        fields.push(oid_tlv(self.oid.as_slice(), limits)?);
        if let Some(parameters) = self.parameters_der {
            asn1::validate_der(parameters.as_slice(), limits)?;
            fields.push(parameters);
        }
        container(48, fields, limits)
    }
}
